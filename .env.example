# =============================================================================
# UAOS — environment
# Copy to `.env.local`. Never commit secrets.
# =============================================================================

# Public site URL (used for CSRF Origin checks and admin links in email)
SITE_URL="http://localhost:3000"

# Neon Postgres (server-only). Prefer pooled connection string.
DATABASE_URL=""

# Admin session + MFA encryption (32-byte hex each)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
MFA_ENC_KEY=""

# Vercel Blob (server-only)
BLOB_READ_WRITE_TOKEN=""

# Cloudflare Turnstile (optional in local/dev; required in production)
# VITE_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Optional: Brevo transactional notify after successful join save (low-PII)
# BREVO_API_KEY="xkeysib-…"
# NOTIFY_EMAIL_TO="office@example.com"
# NOTIFY_EMAIL_FROM="UAOS <office@example.com>"

# Consent / privacy policy version stamped into consents table
PRIVACY_POLICY_VERSION="2026-08-03"

# Legacy placeholders (unused)
GEMINI_API_KEY=""
APP_URL=""
