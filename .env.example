# =============================================================================
# UAOS — environment template
# Copy to `.env.local` and fill secrets. Never commit `.env.local`.
# Full map (where each secret lives): docs/ENV.md
# Sync local → Vercel Development: npm run dev:sync-env
# =============================================================================

# CSRF Origin + links in mail. Local: localhost. Preview/Production: set in Vercel.
SITE_URL="http://localhost:3000"

# Neon Postgres (server-only). Prefer pooled connection string.
DATABASE_URL=""

# Admin session + MFA encryption (32-byte hex each)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
MFA_ENC_KEY=""

# Optional override for the policy version stamped into consents.
# Leave empty: the published value comes from src/lib/privacyPolicy.ts and must match /privacy.
PRIVACY_POLICY_VERSION=""

# Vercel Blob (server-only)
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# Cloudflare Turnstile (optional locally; required in production)
# Widget hostnames must include localhost + production host
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: Brevo transactional email (join notify + admin password recovery)
# Join notify needs BREVO_API_KEY + NOTIFY_EMAIL_TO + NOTIFY_EMAIL_FROM
# Admin recovery needs BREVO_API_KEY + NOTIFY_EMAIL_FROM (sends to the admin account email)
BREVO_API_KEY=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""
