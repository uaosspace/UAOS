# =============================================================================
# UAOS — environment template
# Copy to `.env.local` and fill secrets. Never commit `.env.local`.
# Full map (where each secret lives): docs/ENV.md
# Sync local → Vercel Development: npm run dev:sync-env
# =============================================================================

# CSRF Origin + links in mail. Local: localhost. Preview/Production: set in Vercel.
SITE_URL="http://localhost:3000"

# Neon Postgres (server-only). Prefer pooled connection string.
DATABASE_URL=""

# Admin session + MFA encryption (32-byte hex each)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
MFA_ENC_KEY=""

# Optional override for the policy version stamped into consents.
# Leave empty: the published value comes from src/lib/privacyPolicy.ts and must match /privacy.
PRIVACY_POLICY_VERSION=""

# Vercel Blob (server-only)
# Public store — covers/images for the site (access: public)
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
# Optional dedicated private store — member-only documents (access: private)
UAOS_PRIVATE_READ_WRITE_TOKEN=""
UAOS_PRIVATE_BLOB_STORE_ID=""

# Cloudflare Turnstile (optional locally; secret required in production).
# Empty token is temporarily soft-skipped server-side if the widget did not mount.
# Widget hostnames must include localhost + production host
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Optional: Brevo transactional email (join notify + admin password recovery)
# Join notify needs BREVO_API_KEY + NOTIFY_EMAIL_TO + NOTIFY_EMAIL_FROM
# Admin recovery needs BREVO_API_KEY + NOTIFY_EMAIL_FROM (sends to the admin account email)
BREVO_API_KEY=""
NOTIFY_EMAIL_TO=""
# Optional: Gemini drafts translations in admin («suggest translation» button)
# Free / paid key from Google AI Studio. Never expose as VITE_*.
GEMINI_API_KEY=""
# Optional model id (default gemini-flash-latest; gemini-2.0-flash often has free-tier limit 0)
GEMINI_MODEL=""

# Meeting provider — Zoom Server-to-Server OAuth (server-only, never VITE_*)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_HOST_USER_ID=""
ZOOM_WEBHOOK_SECRET=""
# AES-256-GCM key for meeting start_url at rest (64 hex). Falls back to MFA_ENC_KEY if empty.
MEETING_START_URL_ENC_KEY=""

# Protects /api/cron/meetings (Vercel Cron Authorization: Bearer …)
CRON_SECRET=""
