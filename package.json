    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "luxon": "^3.7.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.1.8",
    "autoprefixer": "^10.4.21",
